# ============================================================
# Docker Compose용 환경변수 (docker compose up 할 때 사용)
# 이 파일을 복사해 같은 위치에 .env 를 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 대상이라 GitHub에 올라가지 않습니다.
# 각 값을 어디서 받는지는 README의 "API 키 발급" 참고
# ============================================================

# MySQL root 비밀번호 (직접 정하기)
DB_PASSWORD=

# JWT 서명용 비밀 키 (32자 이상 랜덤 문자열)
JWT_SECRET=

# 카카오 REST API 키 (백엔드 길찾기)
KAKAO_REST_API_KEY=

# 한국관광공사 TourAPI 서비스 키 (Decoding 키)
TOURAPI_SERVICE_KEY=

# SSAFY GMS 키 (AI 일정 생성). 없으면 AI 기능만 동작하지 않음
GMS_KEY=
