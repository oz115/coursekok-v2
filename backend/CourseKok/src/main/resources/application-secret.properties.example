# ============================================================
# IntelliJ / VS Code 로 백엔드를 직접 실행할 때 사용하는 비밀 설정
# 이 파일을 복사해 같은 폴더에 application-secret.properties 를 만들고 값을 채우세요.
# .gitignore 대상이라 GitHub에 올라가지 않습니다.
# 값은 루트 .env 와 맞춰 두세요.
# ============================================================

# Docker Compose로 띄운 DB (docker compose up -d db) 기준
DB_URL=jdbc:mysql://localhost:3307/travel_db?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=

KAKAO_REST_API_KEY=
tourapi.service-key=
GMS_KEY=
