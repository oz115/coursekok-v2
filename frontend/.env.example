# ============================================================
# 프론트엔드 환경변수 (Vite)
# 이 파일을 복사해 frontend/.env 를 만들고 값을 채우세요.
# VITE_ 값은 "빌드할 때" 파일에 박힙니다. 값을 바꾸면 다시 빌드해야 합니다.
# ============================================================

# API 주소
#   pnpm dev 로 개발할 때:          http://localhost:8080/api
#   Docker(Nginx) 배포용 빌드:      /api
VITE_API_BASE_URL=http://localhost:8080/api

# 카카오 JavaScript 키 (지도)
VITE_KAKAO_MAP_KEY=

# 카카오 REST API 키 (길찾기, 개발 서버 전용)
# 임시 구조: 브라우저에 키가 노출되고 빌드 후엔 동작하지 않음. 백엔드 경유로 변경 예정
VITE_KAKAO_REST_API_KEY=
